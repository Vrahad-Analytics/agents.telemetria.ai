# agents.telemetria.ai Environment Configuration

PROJECT_NAME="agents.telemetria.ai"
ENVIRONMENT="development"
DEBUG=True

# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Vrahad-analytics-Cluster"
MONGODB_USERNAME="talk_db_user"
MONGODB_PASSWORD="<password>"
MONGODB_DB_NAME="telemetria_agents"

# Security & Authentication
SECRET_KEY="telemetria-super-secret-jwt-key-for-auth"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Gateway API Keys (Optional for live routing)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
